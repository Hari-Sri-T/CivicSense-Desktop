# Desktop default: download and run the paper's selected model in-process.
CIVICSENSE_BACKEND=embedded
# Optional cache location (otherwise use your OS application data directory).
# CIVICSENSE_DATA_DIR=/path/to/CivicSense
# Optional research backend; embedded mode needs no external server.
# CIVICSENSE_BACKEND=lmstudio
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Leave unset to follow the one available generation model.
# LM_STUDIO_MODEL=qwen2.5-3b-instruct
# /load_file only reads within this directory (default: LegalBench-RAG/corpus).
# CIVICSENSE_EVALUATION_ROOT=/absolute/path/to/LegalBench-RAG/corpus
